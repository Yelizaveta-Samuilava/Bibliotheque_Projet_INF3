  "item": [
    {
      "name": "Utilisateurs",
      "item": [
        {
          "name": "Afficher utilisateurs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/utilisateurs/"
          }
        },
        {
          "name": "Ajouter utilisateur",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Dupont\",\n  \"prenom\": \"Lucie\",\n  \"email\": \"lucie@example.com\",\n  \"mot_de_passe\": \"pass123\",\n  \"role\": \"etudiant\"\n}"
            },
            "url": "{{base_url}}/utilisateurs/"
          }
        }
      ]
    },
    {
      "name": "Livres",
      "item": [
        {
          "name": "Afficher livres",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/livres/"
          }
        },
        {
          "name": "Ajouter livre",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titre\": \"Nouveau Livre\",\n  \"auteur\": \"Auteur X\",\n  \"categorie_id\": 1,\n  \"annee\": 2024,\n  \"stock\": 5,\n  \"disponible\": true\n}"
            },
            "url": "{{base_url}}/livres/"
          }
        },
        {
          "name": "Recherche avancée",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/livres/search?titre=python",
              "host": ["{{base_url}}"],
              "path": ["livres", "search"],
              "query": [
                { "key": "titre", "value": "python" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Catégories",
      "item": [
        {
          "name": "Afficher catégories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/categories/"
